!data/processed/.gitkeep

# Ignore models by default; include only models required by the APIs
models/**
!models/.gitkeep
!models/unet_candle_openvino.xml
!models/unet_candle_openvino.bin
!models/yolo11n_candle_video_best.pt

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors and operating-system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?