# Python environments and cache
.venv/
.venv-*/
__pycache__/
*.py[cod]

# Node.js
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/

# Local environment files
.env
.env.*
!frontend/.env.example
*.local

# Datasets and generated inspection outputs
data/raw/**
data/processed/**
runs/
